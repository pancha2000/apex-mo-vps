# VPS: copy this file to config.env and fill it (bash start.sh reads it).
# Koyeb / other Docker hosts: do NOT commit config.env - set these as Environment variables in the dashboard instead.
# Keep the quotes: the session id contains a '#'
SESSION_ID="your-id#your-key"
OWNER_NUMBER=94XXXXXXXXX
# VPS only: where downloads are stored (needs lots of disk)
VPS_FILES_DIR=/home/ubuntu/files
# Max download size in MB (use a small value like 1000 on hosts with ~2GB disk)
# DL_MAX_MB=1000
